package(default_visibility = ["//visibility:public"])

platform(
    name = "x64_windows-clang-cl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@bazel_tools//tools/cpp:clang-cl",
    ],
)

cc_library(
    name = "jolt",
    srcs = glob(
        ["Jolt/**/*.cpp"],
    ),
    hdrs = glob(
        [
            "Jolt/**/*.h",
            "Jolt/**/*.inl",
        ],
    ),
)

cc_binary(
    name = "hello_world",
    srcs = ["HelloWorld/HelloWorld.cpp"],
    deps = [":jolt"],
)

cc_library(
    name = "vulkan",
    visibility = ["//visibility:public"],
    deps = select({
        "@bazel_tools//src/conditions:windows": ["@vulkan_windows//:vulkan_windows"],
        "@bazel_tools//src/conditions:darwin": ["@vulkan_mac//:vulkan_mac"],
        "//conditions:default": ["@vulkan_linux//:vulkan_linux"],
    }),
)

cc_library(
    name = "test_framework",
    srcs = glob(
        [
            "TestFramework/**/*.cpp",
        ],
        exclude = [
            "TestFramework/Input/**/*.cpp",
            "TestFramework/Window/**/*.cpp",
        ],
    ),
    defines = [
        "JPH_OBJECT_STREAM",
        "JPH_DEBUG_RENDERER",
        "JPH_USE_VK",
    ],
    includes = [
        "TestFramework",
    ],
    deps = [
        ":jolt",
        ":vulkan",
    ],
)

cc_binary(
    name = "samples",
    srcs = glob(
        [
            "Samples/**/*.cpp",
        ],
    ),
    includes = [
        "Samples",
    ],
    deps = [
        ":test_framework",
    ],
)
