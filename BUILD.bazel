package(default_visibility = ["//visibility:public"])

platform(
    name = "x64_windows-clang-cl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@bazel_tools//tools/cpp:clang-cl",
    ],
)

cc_library(
    name = "jolt",
    srcs = glob(
        ["Jolt/**/*.cpp"],
    ),
    hdrs = glob(
        [
            "Jolt/**/*.h",
            "Jolt/**/*.inl",
        ],
    ),
    copts = ["-I."],
    includes = ["Jolt"],
)

cc_binary(
    name = "hello_world",
    srcs = ["HelloWorld/HelloWorld.cpp"],
    deps = [":jolt"],
)
